# Copy to .env and fill in. Key from https://console.deepgram.com.
#
# Only the generator scripts read this (`pnpm clips`, `pnpm align`). The server
# holds no secrets and the browser never talks to Deepgram, so a DEPLOYED copy
# needs no key at all -- the clips are baked into the image.
DEEPGRAM_API_KEY=

# Optional. Override to point the generator at staging for pre-GA voices.
# DEEPGRAM_API_HOST=api.deepgram.com
