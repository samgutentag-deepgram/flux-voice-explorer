# Secrets. sample.env is the template and IS tracked.
.env
.env.*
!sample.env

# Dependencies and build output
node_modules/
dist/
dist-server/
*.tsbuildinfo
coverage/

# Generated assets. `pnpm clips` writes ~28 MB of audio here, plus the
# timings.json and peaks.json derived from it. All three are reproducible from
# the script plus an API key, and none of it belongs in git.
# NOTE: the Dockerfile copies public/clips from the build context, so
# `make clips` has to run before `fly deploy`. `make deploy` checks that.
public/clips/

# Local tool state
.claude/settings.local.json
.fly/
*.log
.DS_Store

# This repo is PUBLIC. The hub is internal by definition: an unedited build
# ledger, launch scheduling, an unblessed metric baseline, named colleagues.
# It lives in the private twin, samgutentag-deepgram/flux-voice-explorer-lab.
# Untracked here since 2026-08-26. It IS still in this repo's history.
.hub/
