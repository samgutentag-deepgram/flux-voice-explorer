# Secrets. sample.env is the template and IS tracked.
.env
.env.*
!sample.env

# Dependencies and build output
node_modules/
dist/
dist-server/
*.tsbuildinfo
coverage/

# Generated assets. `pnpm clips` writes ~28 MB of audio here, plus the
# timings.json and peaks.json derived from it. All three are reproducible from
# the script plus an API key, and none of it belongs in git.
# NOTE: the Dockerfile copies public/clips from the build context, so
# `make clips` has to run before `fly deploy`. `make deploy` checks that.
public/clips/

# Local tool state
.claude/settings.local.json
.fly/
*.log
.DS_Store

# This repo is PUBLIC and its .hub/ is tracked. The archived objectives board is
# internal planning: launch scheduling, an unblessed metric baseline, a named
# colleague. It stays on disk and out of the repo. Added 2026-08-26.
.hub/objectives-archive.md
